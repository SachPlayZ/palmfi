# --- client ---
NEXT_PUBLIC_ARC_RPC_URL=          # defaults to https://rpc.testnet.arc.network
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional overrides; by default addresses come from deployments/arc.json (pnpm sync:deployments)
NEXT_PUBLIC_PALMFI_FACTORY=
NEXT_PUBLIC_PALMFI_FROM_BLOCK=
NEXT_PUBLIC_PALMFI_HUB=
NEXT_PUBLIC_PALMFI_ORBITAL_HOOK=
NEXT_PUBLIC_PALMFI_ORBITAL_ROUTER=

# --- server: /api/notify + Telegram ---
NOTIFY_API_KEY=            # x-api-key the Sentinel sends (Vault DON secret)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=     # for t.me/<bot>?start=<token> deep links
TELEGRAM_WEBHOOK_SECRET=   # setWebhook secret_token; webhook URL = <APP_URL>/api/telegram/link
TELEGRAM_LINK_SECRET=      # HMAC key for deep-link tokens (defaults to TELEGRAM_BOT_TOKEN)
APP_URL=                   # links in Telegram messages
ARC_RPC_URL=               # server-side reads (Vault wallet check)
# Vercel KV / Upstash Redis REST
KV_REST_API_URL=
KV_REST_API_TOKEN=
